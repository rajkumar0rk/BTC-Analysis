# Copy to .env, then chmod 600 .env. NEVER COMMIT REAL KEYS.
# demo = Delta India testnet, live = real Delta India account
MODE=demo
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=

# Start read-only. Switch to true ONLY after doctor passes and demo verification.
TRADING_ENABLED=false
# LIVE requires BOTH TRADING_ENABLED=true and exactly this explicit acknowledgement:
LIVE_TRADING_ACK=
ISOLATED_MARGIN_CONFIRMED=false
# These are safety limits, not a promise of guaranteed loss control.
PORTFOLIO_BUDGET_USD=100
MARGIN_PER_TRADE_USD=10
LEVERAGE=100
DAILY_LOSS_LIMIT_USD=10
MAX_TRADES_PER_DAY=10
HALT_AFTER_LIQUIDATION=true
MIN_LIQUIDATION_BUFFER_PCT=0.25
MAX_MARK_STALENESS_SECONDS=15
POLL_SECONDS=3

# Loopback only. Open from laptop using SSH tunnel; NEVER expose to internet.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
STATE_DIR=./state
