# BTC/ETH EMA20 + Supertrend multi-asset, multi-venue comparison
# Copy .env.example to .env and chmod 600 .env.
# Per-systemd-lane settings are kept in lane-env/*.env.
MODE=demo
ASSET=BTC
MARKET=futures
TRADING_ENABLED=false
# Futures without exchange orders: simulate 100x entries/exits using fresh bid/ask (default true).
FUTURES_PAPER_ENABLED=true

# DO NOT COMMIT CREDENTIALS. Keys are used only for futures demo exchange orders.
# Options engine is READ-ONLY quote-based paper; no API keys necessary.
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=
LIVE_TRADING_ACK=
ISOLATED_MARGIN_CONFIRMED=false

PORTFOLIO_BUDGET_USD=100
MARGIN_PER_TRADE_USD=10
LEVERAGE=100
# Exit protection only; DOES NOT block a strategy entry. Place stop just
# BEFORE the reported liquidation price to try avoiding liquidation fee.
PRELIQ_STOP_ENABLED=true
PRELIQ_BTC_BUFFER_POINTS=1
# For ETH: BTC buffer * ETH entry / BTC reference (rounded UP to ETH tick).
PRELIQ_BTC_REFERENCE_PRICE=80000

# The pre-entry liquidation stop-buffer guard is OFF (user chose original model).
# At 100x a trade can liquidate before its 2x ATR stop.
DAILY_LOSS_LIMIT_USD=10
MAX_TRADES_PER_DAY=10
HALT_AFTER_LIQUIDATION=true
POLL_SECONDS=3
MAX_MARK_STALENESS_SECONDS=15
MIN_LIQUIDATION_BUFFER_PCT=0.25

# Long CALL on bullish underlying, long PUT on bearish underlying.
# Option purchases use total premium + modeled entry fee + GST <= $10.
OPTION_PREMIUM_BUDGET_USD=10
OPTION_MIN_DTE_HOURS=36
OPTION_MAX_DTE_DAYS=14
OPTION_MAX_SPREAD_PCT=10
# India fee assumption: 0.01% underlying notional, capped at 3.5% premium.
OPTION_TAKER_FEE_RATE=0.0001
OPTION_PREMIUM_FEE_CAP_PCT=3.5

# Dashboard is only available via SSH tunnel.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Leave blank for auto-segregated state/<MODE>/<ASSET>_<MARKET>/.
STATE_DIR=
