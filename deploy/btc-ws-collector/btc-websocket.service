[Unit]
Description=Read-only BTC market microstructure WebSocket recorder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=btcdata
Group=btcdata
WorkingDirectory=/opt/BTC-Analysis
ExecStart=/opt/BTC-Analysis/.venv/bin/python /opt/BTC-Analysis/scripts/collect_btc_websocket_vps.py --data-dir /var/lib/btc-market-data --free-floor-mb 2048
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/btc-market-data
PrivateTmp=true
LimitNOFILE=4096
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
